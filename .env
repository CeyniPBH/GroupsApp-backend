PORT=3000
CORS_ORIGIN=*
JWT_SECRET=secret123
DB_NAME=groupsapp
DB_USER=postgres
DB_PASSWORD=30721   #admin123
#DB_HOST=localhostAWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_S3_BUCKET_NAME=tu-bucket-name# Cambia a "production" si quieres probar que el sequelize.sync() ya NO se ejecuta
NODE_ENV=development 

# Base de datos (Usa host.docker.internal si usas Windows/Mac y tu Postgres está instalado localmente)
DB_HOST=host.docker.internal

# AWS (Necesario para que el cliente S3 no de error al arrancar, aunque no subas archivos en local)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=tu-bucket-groupsapp
# AWS_ACCESS_KEY_ID=... (Si vas a probar subir archivos locales, necesitas tus credenciales AWS en el entorno)
# AWS_SECRET_ACCESS_KEY=...